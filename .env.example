# Turnstile de Cloudflare (captcha gratuito, sin límite de verificaciones).
# Se obtiene en dash.cloudflare.com > Turnstile > Add widget.
# Sin esta variable el sitio usa la clave de prueba, que siempre aprueba.
PUBLIC_TURNSTILE_SITE_KEY=

# La clave secreta NO va aquí ni en el repo: vive en el servidor que valide el
# envío del formulario, porque la validación es del lado del servidor.
# TURNSTILE_SECRET_KEY=

# Destino del envío del formulario (endpoint de Brevo o el intermediario que
# valide el captcha del lado del servidor). Sin esta variable el formulario
# funciona en modo demo: valida y lleva a /gracias, pero no guarda el lead.
PUBLIC_FORM_ENDPOINT=

# Buzón que recibe los leads del formulario.
# Va del lado del servidor a propósito: si la dirección se escribe en el HTML
# de la página, los rastreadores de spam la cosechan.
FORM_DESTINATARIO=contacto@tle.com.mx
