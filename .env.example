# Turnstile de Cloudflare (captcha gratuito, sin límite de verificaciones).
# Se obtiene en dash.cloudflare.com > Turnstile > Add widget.
# Sin esta variable el sitio usa la clave de prueba, que siempre aprueba.
PUBLIC_TURNSTILE_SITE_KEY=

# Clave secreta de Turnstile, la valida src/pages/api/cotizacion.ts (función
# serverless de Vercel). No lleva prefijo PUBLIC_: solo vive en el servidor.
# dash.cloudflare.com > Turnstile > el mismo widget que PUBLIC_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=

# Destino del envío del formulario. Con el endpoint propio en Vercel es
# /api/cotizacion (ruta relativa, mismo origen). Sin esta variable el
# formulario funciona en modo demo: valida y lleva a /gracias, pero no envía nada.
PUBLIC_FORM_ENDPOINT=/api/cotizacion

# API key de Brevo (app.brevo.com > SMTP & API > API Keys) que usa
# src/pages/api/cotizacion.ts para enviar el correo del lead.
BREVO_API_KEY=

# Remitente del correo en Brevo. Debe ser una dirección o dominio validado en
# esa cuenta de Brevo, o los envíos rebotan. Sin esta variable cae en
# noreply@futurite.info. El nombre del remitente va fijo en el código
# ("Formulario TLE Carrier Nacional"), no es configurable por variable.
BREVO_SENDER_EMAIL=

# Buzón que recibe los leads del formulario.
# Va del lado del servidor a propósito: si la dirección se escribe en el HTML
# de la página, los rastreadores de spam la cosechan.
FORM_DESTINATARIO=contacto@tle.com.mx
