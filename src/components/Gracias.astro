---
import Layout from '../layouts/Layout.astro';
import { getDict } from '../i18n';

const lang = Astro.currentLocale ?? 'es';
const t = getDict(lang).gracias;
const inicioHref = lang === 'en' ? '/en' : '/';
---

<Layout title={t.title} description={t.description} noindex>

  <section class="relative min-h-[70vh] flex items-center bg-tle-white overflow-hidden">
    <!-- Mismo tratamiento que las secciones claras de la landing: la foto en
         escala de grises, muy tenue, bajo una vela clara. -->
    <img
      src="/images/bg_contacto.webp"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover grayscale opacity-18 pointer-events-none select-none"
    />
    <div class="absolute inset-0 bg-tle-secondary/35" aria-hidden="true"></div>

    <div class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-24 text-center">
      <div class="w-16 h-16 bg-tle-primary rounded-sm flex items-center justify-center mx-auto mb-8">
        <i class="ph ph-check text-3xl text-tle-black"></i>
      </div>

      <h1 class="text-3xl sm:text-5xl font-display font-extrabold uppercase leading-tight mb-6 text-tle-black">
        {t.h1Pre}<span class="text-tle-primary">{t.h1Highlight}</span>
      </h1>

      <p class="text-gray-600 text-base leading-relaxed mb-10">
        {t.p}
      </p>

      <a href={inicioHref} class="inline-block bg-tle-black text-tle-white px-8 py-4 rounded-sm font-bold hover:bg-tle-primary hover:text-tle-black transition-colors">
        {t.cta}
      </a>
    </div>
  </section>
</Layout>
