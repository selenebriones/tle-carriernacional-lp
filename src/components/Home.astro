---
import Layout from '../layouts/Layout.astro';
import SeccionCotizacion from './SeccionCotizacion.astro';
import { getDict, ruta } from '../i18n';

/* ============================================================================
   TLE — LP Carrier Nacional. Contenido definitivo del cliente.
   Componente compartido por /(index) y /en/(index): el copy sale del
   diccionario del idioma activo (Astro.currentLocale).
   ========================================================================== */

const lang = Astro.currentLocale ?? 'es';
const t = getDict(lang);
---

<Layout title={t.meta.title} description={t.meta.description}>

  <!-- ===================== 1. HERO ===================== -->
  <section class="relative w-full min-h-[80vh] flex items-center bg-tle-black text-tle-white overflow-hidden">
    <!-- Degradado: opaco a la izquierda (donde va el texto) y transparente a la derecha,
         para no tapar el tractocamión. El segundo capa el borde inferior en móvil. -->
    <div class="absolute inset-0 bg-gradient-to-r from-black via-black/60 to-transparent z-10"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent z-10"></div>
    <img
      src={ruta('/images/hero.webp')}
      alt={t.hero.imgAlt}
      data-parallax
      fetchpriority="high"
      width="1456"
      height="971"
      class="absolute inset-x-0 -top-[10%] w-full h-[120%] object-cover object-center z-0"
    />

    <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 w-full">
      <span data-hero-anim class="inline-block bg-tle-primary text-tle-black text-xs font-bold uppercase tracking-[0.2em] px-3 py-1 mb-6">
        {t.hero.badge}
      </span>
      <h1 data-hero-anim class="text-4xl sm:text-5xl lg:text-6xl font-hero font-black leading-[1.08] mb-6 max-w-4xl uppercase">
        {t.hero.h1Pre}<span class="text-tle-primary">{t.hero.h1Highlight}</span>
      </h1>
      <p data-hero-anim class="text-gray-300 text-base sm:text-lg max-w-3xl mb-4 font-light leading-relaxed">
        {t.hero.p1}
      </p>
      <p data-hero-anim class="text-tle-primary text-sm sm:text-base font-medium max-w-3xl mb-10">
        {t.hero.p2}
      </p>
      <div data-hero-anim class="flex flex-col sm:flex-row gap-4">
        <a href="#contacto" class="bg-tle-primary text-tle-black px-8 py-4 rounded-sm font-bold hover:bg-white transition-all text-center">
          {t.hero.ctaPrimary}
        </a>
        <a href="#servicios" class="border border-white/40 text-tle-white px-8 py-4 rounded-sm font-bold hover:bg-white/10 transition-all text-center">
          {t.hero.ctaSecondary}
        </a>
      </div>
    </div>
  </section>


  <!-- ===================== 2. CERTIFICACIONES ===================== -->
  <section class="bg-tle-white py-16 border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 data-reveal class="text-center text-2xl sm:text-3xl font-display font-bold text-tle-black mb-12 uppercase tracking-wide">
        {t.certificaciones.heading}
      </h2>
      <div data-reveal-stagger class="grid grid-cols-1 sm:grid-cols-3 gap-10 text-center">
        {t.certificaciones.items.map((c) => (
          <div class="flex flex-col items-center">
            <div class="h-24 flex items-center justify-center mb-4">
              <img src={ruta(c.img)} alt={c.nombre} width="240" height="240" loading="lazy" class={`${c.alto} w-auto object-contain`} />
            </div>
            <span class="text-sm font-bold text-tle-black">{c.nombre}</span>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ===================== 3. RESPALDO (línea horizontal) ===================== -->
  <section class="relative py-20 bg-tle-secondary overflow-hidden">
    <!-- Fondo: la flotilla en escala de grises, muy tenue para no competir con el texto. -->
    <img
      src={ruta('/images/bg_respaldo.webp')}
      alt=""
      aria-hidden="true"
      loading="lazy"
      width="1429"
      height="702"
      class="absolute inset-0 w-full h-full object-cover grayscale opacity-18 pointer-events-none select-none"
    />
    <!-- Vela clara: mantiene el contraste del texto por encima de la fotografía. -->
    <div class="absolute inset-0 bg-tle-secondary/35" aria-hidden="true"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div data-reveal class="text-center mb-14">
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-tle-black uppercase tracking-wide">{t.respaldo.heading}</h2>
        <div class="w-16 h-1 bg-tle-primary mx-auto mt-4"></div>
      </div>

      <div data-reveal-stagger class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-gray-300">
        {t.respaldo.items.map((item) => (
          <div class="px-8 py-8 md:py-2 text-center flex flex-col items-center">
            <div class="w-16 h-16 bg-tle-primary flex items-center justify-center rounded-sm mb-5">
              <i class={`ph ${item.icon} text-3xl text-tle-black`}></i>
            </div>
            <h3 class="text-base font-bold text-tle-black mb-3">{item.titulo}</h3>
            <p class="text-sm text-gray-600 leading-relaxed max-w-xs">{item.copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ===================== 4. INTEGRACIÓN LOGÍSTICA ===================== -->
  <section class="py-20 bg-tle-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div data-reveal class="text-center mb-14">
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-tle-black uppercase tracking-wide">{t.integracion.heading}</h2>
        <div class="w-16 h-1 bg-tle-primary mx-auto mt-4"></div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-10">
        <h3 data-reveal class="text-lg font-bold text-gray-500 pb-4 border-b-2 border-gray-200">
          {t.integracion.preguntaIzq}
        </h3>
        <h3 data-reveal class="text-lg font-bold text-tle-black pb-4 border-b-2 border-tle-primary">
          {t.integracion.preguntaDer}
        </h3>
      </div>

      <!-- Cada par dolor → solución se lee en la misma fila -->
      <div class="mt-8 space-y-6">
        {t.integracion.pares.map((par) => (
          <div data-reveal-stagger class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-10 items-stretch">
            <div class="flex gap-4 bg-tle-secondary p-6 rounded-sm">
              <i class="ph ph-x-circle text-2xl text-gray-400 shrink-0"></i>
              <p class="text-sm text-gray-600 leading-relaxed">{par.dolor}</p>
            </div>
            <div class="flex gap-4 bg-tle-secondary p-6 rounded-sm border-l-4 border-tle-primary">
              <i class="ph ph-check-circle text-2xl text-tle-accent shrink-0"></i>
              <p class="text-sm font-medium text-tle-black leading-relaxed">{par.solucion}</p>
            </div>
          </div>
        ))}
      </div>

      <div data-reveal class="text-center mt-14">
        <a href="#contacto" class="inline-flex items-center gap-2 bg-tle-black text-tle-white px-8 py-4 rounded-sm font-bold text-sm hover:bg-tle-primary hover:text-tle-black transition-colors">
          {t.integracion.cta} <i class="ph ph-arrow-right"></i>
        </a>
      </div>
    </div>
  </section>


  <!-- ===================== 5. SERVICIOS NACIONALES ===================== -->
  <section id="servicios" class="py-20 bg-tle-secondary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div data-reveal class="text-center mb-14">
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-tle-black uppercase tracking-wide">{t.servicios.heading}</h2>
        <div class="w-16 h-1 bg-tle-primary mx-auto mt-4"></div>
      </div>

      <!-- Flex en lugar de grid: son 5 tarjetas en filas de 3, y así la última fila
           (2 tarjetas) queda centrada en vez de alineada a la izquierda. -->
      <div data-reveal-stagger class="flex flex-wrap justify-center gap-6">
        {t.servicios.items.map((s) => (
          <article class="group relative overflow-hidden rounded-sm border-t-2 border-tle-primary min-h-[420px] flex flex-col justify-end w-full sm:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)]">
            {/* Fondo: la imagen se aleja del texto con un degradado para mantener el contraste */}
            <img
              src={ruta(s.img)}
              alt=""
              aria-hidden="true"
              loading="lazy"
              class={`absolute inset-0 w-full h-full object-cover ${s.pos ?? 'object-center'} transition-transform duration-700 group-hover:scale-105`}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/75 to-black/20"></div>

            <div class="relative z-10 p-7">
              <i class={`ph ${s.icon} text-3xl text-tle-primary mb-4 block`}></i>
              <h3 class="text-lg font-bold text-tle-white mb-4">{s.titulo}</h3>
              <ul class="space-y-3">
                {s.bullets.map((b) => (
                  <li class="flex gap-2 text-xs text-gray-200 leading-relaxed">
                    <i class="ph ph-caret-right text-tle-primary shrink-0 mt-0.5"></i><span>{b}</span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>


  <!-- ===================== 6. COBERTURA Y CONECTIVIDAD ===================== -->
  <section id="cobertura" class="py-24 bg-tle-black text-tle-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div data-reveal class="text-center mb-14">
        <h2 class="text-2xl sm:text-3xl font-display font-bold uppercase tracking-wide">{t.cobertura.heading}</h2>
        <div class="w-16 h-1 bg-tle-primary mx-auto mt-4"></div>
        <p class="text-tle-primary text-base font-medium max-w-3xl mx-auto mt-6">
          {t.cobertura.sub1}
        </p>
        <p class="text-gray-400 text-sm max-w-3xl mx-auto mt-4 leading-relaxed">
          {t.cobertura.sub2}
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div data-reveal class="flex flex-col items-center">
          <img
            src={ruta('/images/mapa_tle_nacional.webp')}
            alt={t.cobertura.mapaAlt}
            width="650"
            height="456"
            loading="lazy"
            class="w-full max-w-xl h-auto"
          />
          <p class="text-xs text-gray-400 mt-4 text-center">
            {t.cobertura.mapaCaption}
          </p>
        </div>

        <div data-reveal-stagger class="space-y-8">
          {t.cobertura.items.map((c) => (
            <div class="flex gap-5">
              <div class="w-12 h-12 bg-tle-primary flex items-center justify-center rounded-sm shrink-0">
                <i class={`ph ${c.icon} text-2xl text-tle-black`}></i>
              </div>
              <div>
                <h3 class="text-base font-bold text-tle-primary mb-2">{c.titulo}</h3>
                {c.copy && <p class="text-sm text-gray-300 leading-relaxed">{c.copy}</p>}
                {c.lista && (
                  <ul class="flex flex-wrap gap-2 mt-1">
                    {c.lista.map((ciudad) => (
                      <li class="text-xs text-gray-200 bg-white/10 border border-white/15 rounded-sm px-3 py-1.5">
                        {ciudad}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>

      <div data-reveal class="text-center mt-14">
        <a href="#contacto" class="inline-flex items-center gap-2 bg-tle-primary text-tle-black px-8 py-4 rounded-sm font-bold text-sm hover:bg-white transition-colors">
          {t.cobertura.cta} <i class="ph ph-arrow-right"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- ===================== 6b. COTIZACIÓN (tras cobertura) ===================== -->
  <SeccionCotizacion
    anchorId="cotiza-cobertura"
    sufijo="cobertura"
    titulo={t.cotizacionCobertura.titulo}
    copy={t.cotizacionCobertura.copy}
  />



  <!-- ===================== 7. UNIDADES ===================== -->
  <section id="unidades" class="py-20 bg-tle-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div data-reveal class="text-left mb-14">
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-tle-black uppercase tracking-wide">{t.unidades.heading}</h2>
        <div class="w-16 h-1 bg-tle-primary mt-4"></div>
      </div>

      <!-- items-stretch: la columna de la imagen iguala la altura de la lista -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-stretch">
        <!-- Columna izquierda: selector de unidad -->
        <div data-reveal-stagger role="tablist" aria-label={t.unidades.ariaTablist} class="flex flex-col gap-3">
          {t.unidades.items.map((u, i) => (
            <button
              type="button"
              role="tab"
              id={`unidad-tab-${i}`}
              aria-controls={`unidad-panel-${i}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? '0' : '-1'}
              data-unidad={i}
              class="group w-full text-left flex items-center gap-4 p-5 rounded-sm bg-tle-secondary border-l-4 border-transparent transition-all hover:bg-gray-100 aria-selected:bg-tle-black aria-selected:border-tle-primary cursor-pointer"
            >
              <i class={`ph ${u.icon} text-2xl text-tle-black shrink-0 group-aria-selected:text-tle-primary`}></i>
              <span class="text-sm font-bold text-tle-black group-aria-selected:text-tle-white">{u.nombre}</span>
              <i class="ph ph-arrow-right ml-auto text-tle-primary opacity-0 group-aria-selected:opacity-100 transition-opacity"></i>
            </button>
          ))}
        </div>

        <!-- Columna derecha: imagen de la unidad seleccionada -->
        <div data-reveal class="relative w-full h-full aspect-16/10 lg:aspect-auto rounded-sm overflow-hidden bg-tle-secondary">
          {t.unidades.items.map((u, i) => (
            <figure
              role="tabpanel"
              id={`unidad-panel-${i}`}
              aria-labelledby={`unidad-tab-${i}`}
              data-panel={i}
              hidden={i !== 0}
              class="absolute inset-0 m-0"
            >
              <img src={ruta(u.img)} alt={u.alt} loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
              <figcaption class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/90 to-transparent text-tle-white text-sm font-bold p-5">
                {u.nombre}
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>


  <!-- ===================== 8. PROCESO OPERATIVO (línea de tiempo) ===================== -->
  <section id="proceso" class="py-20 bg-tle-secondary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div data-reveal class="text-center mb-16">
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-tle-black uppercase tracking-wide">{t.proceso.heading}</h2>
        <div class="w-16 h-1 bg-tle-primary mx-auto mt-4"></div>
      </div>

      <!-- Pendiente: sustituir el número por imagen de cada etapa -->
      <div data-reveal-stagger class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-y-10 gap-x-4">
        {t.proceso.items.map((p, i) => (
          <div class="relative flex flex-col items-center text-center px-2">
            <div class="w-16 h-16 rounded-full bg-tle-primary text-tle-black font-hero font-black text-xl flex items-center justify-center mb-5 relative z-10">
              {p.n}
            </div>
            {/* Conector hacia el siguiente paso: solo entre tarjetas de la misma fila */}
            {i < t.proceso.items.length - 1 && (
              <span class="hidden lg:block absolute top-8 left-1/2 w-full h-px bg-gray-300 z-0" aria-hidden="true">
                <i class="ph ph-caret-right absolute -right-1 -top-2.5 text-gray-400 text-sm"></i>
              </span>
            )}
            <h3 class="text-base font-bold text-tle-black mb-3">{p.titulo}</h3>
            <p class="text-xs text-gray-600 leading-relaxed">{p.copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ===================== 9. SECTORES ATENDIDOS ===================== -->
  <section class="py-20 bg-tle-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div data-reveal class="text-center mb-14">
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-tle-black uppercase tracking-wide">{t.sectores.heading}</h2>
        <div class="w-16 h-1 bg-tle-primary mx-auto mt-4"></div>
      </div>

      <!-- Pendiente: imagen contextual por sector, en lugar del icono -->
      <div data-reveal-stagger class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {t.sectores.items.map((s) => (
          <div class="bg-tle-secondary p-7 rounded-sm border-l-4 border-tle-primary flex flex-col">
            <i class={`ph ${s.icon} text-3xl text-tle-black mb-4 block`}></i>
            <h3 class="text-base font-bold text-tle-black mb-2">{s.titulo}</h3>
            <p class="text-xs text-gray-600 leading-relaxed">{s.copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ===================== 10. SEGURIDAD Y TECNOLOGÍA ===================== -->
  <section class="py-20 bg-tle-secondary border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div data-reveal class="text-center mb-14">
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-tle-black uppercase tracking-wide">{t.seguridad.heading}</h2>
        <div class="w-16 h-1 bg-tle-primary mx-auto mt-4"></div>
      </div>

      <div data-reveal class="bg-tle-white rounded-sm overflow-hidden border border-gray-200">
        <div class="hidden sm:grid grid-cols-2 bg-tle-black text-tle-white text-xs font-bold uppercase tracking-widest">
          <div class="px-6 py-4">{t.seguridad.colRecurso}</div>
          <div class="px-6 py-4 border-l border-gray-800">{t.seguridad.colBeneficio}</div>
        </div>
        {t.seguridad.items.map((row, i) => (
          <div class={`grid grid-cols-1 sm:grid-cols-2 ${i % 2 === 1 ? 'bg-tle-secondary' : 'bg-tle-white'} ${i > 0 ? 'border-t border-gray-200' : ''}`}>
            <div class="px-6 py-5">
              <p class="text-sm font-bold text-tle-black">{row.recurso}</p>
              <p class="text-xs text-gray-500 mt-1">{row.recursoDetalle}</p>
            </div>
            <div class="px-6 py-5 sm:border-l border-gray-200 border-t sm:border-t-0">
              <p class="text-sm font-bold text-tle-accent">{row.beneficio}</p>
              <p class="text-xs text-gray-600 mt-1">{row.beneficioDetalle}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ===================== 11. RESPALDO INSTITUCIONAL ===================== -->
  <section class="py-20 bg-tle-white border-y border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div data-reveal class="text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-tle-black uppercase tracking-wide">{t.institucional.heading}</h2>
        <div class="w-16 h-1 bg-tle-primary mx-auto mt-4"></div>
      </div>

      <!-- Nota del cliente: aún no hay caso de éxito real, se publica el testimonio -->
      <blockquote data-reveal class="max-w-3xl mx-auto text-center mb-16">
        <i class="ph ph-quotes text-4xl text-tle-primary mb-4 block"></i>
        <p class="text-base text-gray-700 leading-relaxed italic">
          {t.institucional.quote}
        </p>
        <footer class="text-sm font-bold text-tle-black mt-6">
          {t.institucional.quoteFooter}
        </footer>
      </blockquote>

      <div data-reveal-stagger class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {t.institucional.items.map((r) => (
          <div class="bg-tle-secondary p-6 rounded-sm border-t-2 border-tle-primary flex flex-col">
            {/* Caja de alto fijo para que el año y el premio queden a la misma
                altura en todas las tarjetas, tengan logo o no. */}
            <div class="h-12 flex items-center mb-4">
              {r.logo && (
                <img src={ruta(r.logo)} alt={r.marca} loading="lazy" class="max-h-12 w-auto max-w-[70%] object-contain object-left" />
              )}
            </div>
            <span class="block text-xs font-bold text-tle-accent tracking-wide mb-2">{r.anios}</span>
            <p class="text-sm font-semibold text-tle-black leading-snug">{r.premio}</p>
          </div>
        ))}
      </div>
    </div>
  </section>



  <!-- ===================== 12. COTIZACIÓN ===================== -->
  <SeccionCotizacion anchorId="contacto" sufijo="final" />




</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = Array.from(document.querySelectorAll('[data-unidad]'));
    const panels = Array.from(document.querySelectorAll('[data-panel]'));
    if (!tabs.length) return;

    const activar = (i) => {
      tabs.forEach((t, j) => {
        t.setAttribute('aria-selected', String(j === i));
        t.setAttribute('tabindex', j === i ? '0' : '-1');
      });
      panels.forEach((p, j) => { p.hidden = j !== i; });
    };

    // --- Avance automático ---
    // Un solo temporizador que siempre corre; en cada tick decide si avanza.
    // Antes se arrancaba y detenía con mouseenter/mouseleave e IntersectionObserver,
    // pero si el cursor ya estaba sobre la sección al llegar (lo normal al hacer
    // scroll), la pausa se activaba y nunca se reanudaba.
    const REDUCE = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const INTERVALO = 4000;
    const seccion = document.getElementById('unidades');
    let actual = 0;
    let elegidaAMano = false;

    const enPantalla = () => {
      const r = seccion.getBoundingClientRect();
      return r.top < window.innerHeight && r.bottom > 0;
    };

    if (!REDUCE) {
      setInterval(() => {
        if (elegidaAMano || document.hidden || !enPantalla()) return;
        if (seccion.contains(document.activeElement)) return; // alguien navegando con teclado
        actual = (actual + 1) % tabs.length;
        activar(actual);
      }, INTERVALO);
    }

    // Al elegir una unidad la rotación se detiene: si la persona quiso verla,
    // no se le cambia debajo.
    const seleccionManual = (i) => { elegidaAMano = true; actual = i; activar(i); };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => seleccionManual(i));
      // Flechas para moverse entre unidades sin salir del teclado.
      tab.addEventListener('keydown', (e) => {
        const dir = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1
                  : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
        if (!dir) return;
        e.preventDefault();
        const siguiente = (i + dir + tabs.length) % tabs.length;
        seleccionManual(siguiente);
        tabs[siguiente].focus();
      });
    });
  });
</script>
