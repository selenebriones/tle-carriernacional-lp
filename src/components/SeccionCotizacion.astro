---
/* ============================================================================
   Sección de cotización, reutilizable.

   El formulario en sí es un embed del CRM del cliente (GoHighLevel /
   LeadConnector): ellos captan y procesan el lead directamente, este
   componente solo pone el empaque visual del sitio alrededor.

   La página la monta más de una vez, así que el id del iframe se sufija con
   `sufijo` — dos iframes con el mismo id rompen el auto-resize que hace
   /js/form_embed.js (usa el id para saber a cuál mensaje responder).
   ========================================================================== */

import { getDict } from '../i18n';

interface Props {
  /** id del <section>, el que usan los enlaces ancla. */
  anchorId: string;
  /** Sufijo único para el id del iframe. */
  sufijo: string;
  /** El <h2> de la sección. */
  titulo?: string;
  /** Párrafo bajo el título. */
  copy?: string;
}

const lang = Astro.currentLocale ?? 'es';
const t = getDict(lang).cotizacionDefault;

const {
  anchorId,
  sufijo,
  titulo = t.titulo,
  copy = t.copy,
} = Astro.props;

// Formulario real en LeadConnector, uno por idioma. No cambia entre
// instancias: es el mismo formulario embebido dos veces en la página.
const CRM_FORMS = {
  es: { id: 'IjKoqvBNilZMS77Dw4A1', nombre: 'Form_Landing TLE' },
  en: { id: 'Bo4A65ufceEQf2GV0liY', nombre: 'Form_Landing TLE - EN' },
} as const;
const { id: CRM_FORM_ID, nombre: CRM_FORM_NAME } = lang === 'en' ? CRM_FORMS.en : CRM_FORMS.es;
const iframeId = `inline-${CRM_FORM_ID}-${sufijo}`;
---

<section id={anchorId} class="relative py-24 bg-tle-primary overflow-hidden">
  <!-- Fondo: la flotilla en escala de grises, tenue bajo una capa del amarillo TLE. -->
  <img
    src="/images/bg_contacto.webp"
    alt=""
    aria-hidden="true"
    loading="lazy"
    width="1426"
    height="951"
    class="absolute inset-0 w-full h-full object-cover grayscale opacity-30 pointer-events-none select-none"
  />
  <div class="absolute inset-0 bg-tle-primary/55" aria-hidden="true"></div>

  <div class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div data-reveal class="text-center mb-12">
      <h2 class="text-2xl sm:text-4xl font-display font-extrabold text-tle-black mb-4 uppercase">{titulo}</h2>
      <p class="text-tle-black/70 text-sm max-w-2xl mx-auto leading-relaxed">{copy}</p>
    </div>

    <div data-reveal class="relative bg-tle-white p-4 sm:p-6 rounded-sm shadow-lg">
      <iframe
        src={`https://api.leadconnectorhq.com/widget/form/${CRM_FORM_ID}`}
        style="width:100%;height:884px;border:none;border-radius:8px;display:block"
        id={iframeId}
        data-layout="{'id':'INLINE'}"
        data-trigger-type="alwaysShow"
        data-trigger-value=""
        data-activation-type="alwaysActivated"
        data-activation-value=""
        data-deactivation-type="neverDeactivate"
        data-deactivation-value=""
        data-form-name={CRM_FORM_NAME}
        data-height="884"
        data-layout-iframe-id={iframeId}
        data-form-id={CRM_FORM_ID}
        data-cookie-consent="true"
        data-cookie-consent-provider="auto"
        title={`${CRM_FORM_NAME} — ${sufijo}`}
      ></iframe>
    </div>
  </div>
</section>
