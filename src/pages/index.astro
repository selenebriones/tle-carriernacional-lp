      <!-- El formulario todavía no envía a ningún destino -->
      <form data-reveal class="bg-tle-white p-8 sm:p-10 rounded-sm space-y-5 shadow-lg">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label for="nombre" class="block text-xs font-bold uppercase tracking-wider mb-2 text-tle-black">Nombre y apellido</label>
            <input id="nombre" name="nombre" type="text" required class="w-full bg-tle-secondary border border-gray-200 px-4 py-3 text-sm rounded-sm focus:border-tle-primary outline-none" />
          </div>
          <div>
            <label for="empresa" class="block text-xs font-bold uppercase tracking-wider mb-2 text-tle-black">Empresa</label>
            <input id="empresa" name="empresa" type="text" required class="w-full bg-tle-secondary border border-gray-200 px-4 py-3 text-sm rounded-sm focus:border-tle-primary outline-none" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label for="correo" class="block text-xs font-bold uppercase tracking-wider mb-2 text-tle-black">Correo corporativo</label>
            <input id="correo" name="correo" type="email" required class="w-full bg-tle-secondary border border-gray-200 px-4 py-3 text-sm rounded-sm focus:border-tle-primary outline-none" />
          </div>
          <div>
            <label for="telefono" class="block text-xs font-bold uppercase tracking-wider mb-2 text-tle-black">Teléfono</label>
            <input id="telefono" name="telefono" type="tel" required class="w-full bg-tle-secondary border border-gray-200 px-4 py-3 text-sm rounded-sm focus:border-tle-primary outline-none" />
          </div>
        </div>

        <div>
          <label for="ruta" class="block text-xs font-bold uppercase tracking-wider mb-2 text-tle-black">Origen y destino</label>
          <input id="ruta" name="ruta" type="text" placeholder="Ej. Monterrey → Silao" class="w-full bg-tle-secondary border border-gray-200 px-4 py-3 text-sm rounded-sm focus:border-tle-primary outline-none" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label for="servicio" class="block text-xs font-bold uppercase tracking-wider mb-2 text-tle-black">Tipo de servicio</label>
            <select id="servicio" name="servicio" class="w-full bg-tle-secondary border border-gray-200 px-4 py-3 text-sm rounded-sm focus:border-tle-primary outline-none">
              {servicios.map((s) => <option>{s.titulo}</option>)}
